<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema del arranque: fondo de marca (y color del splash de Android 12+). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_fondo</item>
    </style>
    <!-- Tema mientras arranca la UI de Flutter y detrás de ella. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_fondo</item>
    </style>
</resources>
