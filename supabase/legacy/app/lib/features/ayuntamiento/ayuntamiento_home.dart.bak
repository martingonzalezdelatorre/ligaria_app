import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import '../../core/area_tabs.dart';
import '../../core/auth.dart';
import '../../core/config.dart';
import '../../core/widgets.dart';
import '../../data/liga_repository.dart';
import '../../data/models.dart';
import '../organizador/correcciones_tab.dart';
import '../organizador/ligas_tab.dart';
import '../organizador/pendientes_tab.dart';
import '../superadmin/superadmin_providers.dart' show slugDe;
import 'ayuntamiento_providers.dart';

/// Área de la administración municipal: crea y organiza las ligas del municipio, ve sus escuelas y configura su web.
class AyuntamientoHome extends StatelessWidget {
  const AyuntamientoHome(
      {super.key, required this.ayuntamientoId, required this.organizadoraId, required this.nombre, required this.slug});
  final String ayuntamientoId, organizadoraId, nombre, slug;

  @override
  Widget build(BuildContext context) => AreaTabs(secciones: [
        SeccionArea(Icons.emoji_events_outlined, 'Ligas', LigasTab(escuelaId: organizadoraId), iconoActivo: Icons.emoji_events),
        SeccionArea(Icons.pending_actions_outlined, 'Pendientes', PendientesTab(escuelaId: organizadoraId), iconoActivo: Icons.pending_actions),
        SeccionArea(Icons.edit_note_outlined, 'Correcciones', CorreccionesTab(escuelaId: organizadoraId), iconoActivo: Icons.edit_note),
        SeccionArea(Icons.school_outlined, 'Escuelas', _EscuelasTab(ayuntamientoId), iconoActivo: Icons.school),
        SeccionArea(Icons.language_outlined, 'Mi web', _AjustesTab(ayuntamientoId: ayuntamientoId, nombre: nombre, slug: slug),
            iconoActivo: Icons.language),
      ]);
}

class _EscuelasTab extends ConsumerWidget {
  const _EscuelasTab(this.id);
  final String id;

  @override
  Widget build(BuildContext context, WidgetRef ref) => AsyncView<List<EscuelaAdmin>>(
        value: ref.watch(escuelasAyuntamientoProvider(id)),
        onRetry: () => ref.invalidate(escuelasAyuntamientoProvider(id)),
        builder: (lista) => lista.isEmpty
            ? const EstadoVacio(
                icono: Icons.school_outlined,
                texto: 'Aún no hay escuelas vinculadas a tu ayuntamiento.\nLa plataforma las irá añadiendo.')
            : ListView(padding: const EdgeInsets.symmetric(vertical: 8), children: [
                for (final e in lista)
                  ListTile(
                    leading: const Icon(Icons.school_outlined),
                    title: Text(e.nombre),
                    subtitle: Text(e.activa ? 'Activa' : 'Inactiva'),
                  ),
              ]),
      );
}

class _AjustesTab extends ConsumerStatefulWidget {
  const _AjustesTab({required this.ayuntamientoId, required this.nombre, required this.slug});
  final String ayuntamientoId, nombre, slug;
  @override
  ConsumerState<_AjustesTab> createState() => _AjustesState();
}

class _AjustesState extends ConsumerState<_AjustesTab> {
  late final _nombre = TextEditingController(text: widget.nombre);
  late final _slug = TextEditingController(text: widget.slug);
  bool _guardando = false;
  String? _errorSlug;

  @override
  void dispose() {
    _nombre.dispose();
    _slug.dispose();
    super.dispose();
  }

  Future<void> _guardar() async {
    final s = slugDe(_slug.text);
    final err = validarSubdominio(s);
    if (_nombre.text.trim().length < 2) {
      avisar(context, 'Escribe el nombre del ayuntamiento.');
      return;
    }
    setState(() => _errorSlug = err);
    if (err != null) return;
    setState(() => _guardando = true);
    try {
      await ref.read(ligaRepositoryProvider).configurarAyuntamiento(widget.ayuntamientoId, _nombre.text.trim(), s);
      ref.invalidate(pertenenciasProvider);
      if (mounted) avisar(context, 'Guardado. Tu web: https://$s.${AppConfig.baseDomain}');
    } catch (_) {
      if (mounted) setState(() => _errorSlug = 'No se pudo guardar. Puede que ese subdominio ya esté en uso.');
    } finally {
      if (mounted) setState(() => _guardando = false);
    }
  }

  @override
  Widget build(BuildContext context) {
    final cs = Theme.of(context).colorScheme;
    final s = slugDe(_slug.text);
    return ListView(padding: const EdgeInsets.all(16), children: [
      Text('Dirección web de tu ayuntamiento', style: Theme.of(context).textTheme.titleMedium),
      const SizedBox(height: 4),
      Text('Tus vecinos y escuelas entrarán desde esta dirección, con el nombre de tu ayuntamiento.',
          style: TextStyle(color: cs.onSurfaceVariant)),
      const SizedBox(height: 20),
      TextField(
        controller: _nombre,
        decoration: const InputDecoration(labelText: 'Nombre del ayuntamiento', border: OutlineInputBorder()),
      ),
      const SizedBox(height: 16),
      TextField(
        controller: _slug,
        onChanged: (_) => setState(() => _errorSlug = null),
        decoration: InputDecoration(
          labelText: 'Subdominio',
          suffixText: '.${AppConfig.baseDomain}',
          errorText: _errorSlug,
          border: const OutlineInputBorder(),
        ),
      ),
      const SizedBox(height: 8),
      SelectableText('https://${s.isEmpty ? 'tu-ayuntamiento' : s}.${AppConfig.baseDomain}',
          style: TextStyle(color: cs.primary, fontWeight: FontWeight.w700)),
      const SizedBox(height: 4),
      Text('Si cambias el subdominio, la dirección anterior deja de funcionar.', style: TextStyle(color: cs.onSurfaceVariant, fontSize: 12)),
      const SizedBox(height: 24),
      FilledButton(
        onPressed: _guardando ? null : _guardar,
        child: _guardando
            ? const SizedBox(height: 20, width: 20, child: CircularProgressIndicator(strokeWidth: 2))
            : const Text('Guardar'),
      ),
    ]);
  }
}
